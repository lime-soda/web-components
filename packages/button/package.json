{
  "name": "@lime-soda/button",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "button",
    "webcomponent"
  ],
  "files": [
    "CHANGELOG.md",
    "custom-elements.json",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "build-component",
    "build:types": "tsc --project tsconfig.types.json",
    "build:manifest": "build-manifest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run",
    "test:browser": "vp test run --project browser",
    "lint": "vp lint",
    "check": "vp check"
  },
  "dependencies": {
    "@lime-soda/tokens": "workspace:*"
  },
  "peerDependencies": {
    "lit": ">= 3.3.0"
  },
  "devDependencies": {
    "@lime-soda/build": "workspace:*",
    "@lime-soda/tsconfig": "workspace:*",
    "@vitest/browser-playwright": "^4.1.10",
    "axe-core": "^4.13.0",
    "lit": "^3.3.1",
    "playwright": "^1.56.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "customElements": "custom-elements.json"
}
