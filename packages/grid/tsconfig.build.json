{
  "extends": "./tsconfig.json",
  // The shared config sets `noEmit` so a stray `tsc` never writes output. This
  // is the one place that is supposed to: without it the build silently emitted
  // nothing and dist held only the themes it copied.
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**", "src/testing/**"]
}
