{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",

  /*
   * Turbo 2 runs tasks in strict env mode: a task only receives the variables
   * declared here, and everything else is stripped before the command starts.
   *
   * That is what broke CI's browser tests. The job sets PLAYWRIGHT_BROWSERS_PATH
   * so Playwright finds the browsers baked into its image, the variable is
   * plainly there in the shell, and turbo removed it on the way to vitest — so
   * Playwright fell back to $HOME/.cache and reported browsers missing that were
   * installed the whole time. Running the same suite through pnpm directly
   * worked, which is exactly what made it look like the job was already fixed.
   */
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck", "check"],
      // `.d.ts` has to be listed. It is not covered by `*.map` or `*.js`, so a
      // cache hit used to restore a `dist` with the JavaScript and none of the
      // declarations — invisible locally, where the files were already there,
      // and a package published without types in CI.
      "outputs": ["dist/**/*.{js,css,map,ts}", "storybook-static/**"]
    },
    "build:manifest": {
      "dependsOn": ["^build"],
      "outputs": ["custom-elements.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:node": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "bench:node": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "bench:browser": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@lime-soda/storybook#build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
