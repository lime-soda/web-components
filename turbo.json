{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck", "check"],
      // `.d.ts` has to be listed. It is not covered by `*.map` or `*.js`, so a
      // cache hit used to restore a `dist` with the JavaScript and none of the
      // declarations — invisible locally, where the files were already there,
      // and a package published without types in CI.
      "outputs": ["dist/**/*.{js,css,map,ts}", "storybook-static/**"]
    },
    "build:manifest": {
      "dependsOn": ["^build"],
      "outputs": ["custom-elements.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:node": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@lime-soda/storybook#build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
