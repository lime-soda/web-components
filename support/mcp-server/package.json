{
  "name": "@lime-soda/mcp-server",
  "version": "0.1.3",
  "description": "MCP server for Lime Soda web components and design tokens",
  "type": "module",
  "bin": {
    "mcp-server": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "tsx scripts/build-manifests.ts",
    "build": "tsc",
    "dev": "tsx watch index.ts",
    "debug": "pnpm dlx @modelcontextprotocol/inspector@2 node dist/index.js",
    "start": "node dist/index.js",
    "lint": "vp lint"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-components",
    "design-tokens"
  ],
  "author": "Phil Parsons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lime-soda/web-components.git",
    "directory": "support/mcp-server"
  },
  "dependencies": {
    "@lime-soda/tokens": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "custom-elements-manifest": "^2.1.0",
    "dotenv": "^18.0.9",
    "glob": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
