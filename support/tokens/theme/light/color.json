{
  "theme": {
    "color": {
      "$type": "color",
      "primary": {
        "background": {
          "$value": "{color.teal.600}",
          "$description": "Teal background"
        },
        "backgroundHover": {
          "$value": "{color.teal.700}",
          "$description": "Background on hover"
        },
        "backgroundActive": {
          "$value": "{color.teal.800}",
          "$description": "Background when active"
        },
        "backgroundSubtle": {
          "$value": "{color.teal.50}",
          "$description": "Subtle background wash"
        },
        "text": {
          "$value": "{color.teal.700}",
          "$description": "Text colour on a plain background"
        },
        "textOnBackground": {
          "$value": "{color.white}",
          "$description": "Text colour on the accent background"
        }
      },
      "secondary": {
        "background": {
          "$value": "{color.taupe.600}",
          "$description": "Taupe background"
        },
        "backgroundHover": {
          "$value": "{color.taupe.700}",
          "$description": "Background on hover"
        },
        "backgroundActive": {
          "$value": "{color.taupe.800}",
          "$description": "Background when active"
        },
        "backgroundSubtle": {
          "$value": "{color.taupe.50}",
          "$description": "Subtle background wash"
        },
        "text": {
          "$value": "{color.taupe.700}",
          "$description": "Text colour on a plain background"
        },
        "textOnBackground": {
          "$value": "{color.white}",
          "$description": "Text colour on the accent background"
        }
      },
      "accent": {
        "$value": "{theme.color.primary.background}",
        "$description": "Colour of a control in its selected state \u2014 a ticked checkbox, a chosen radio, a range thumb. Follows the primary by default; retarget it here to move every such control at once"
      },
      "accentSubtle": {
        "$value": "color-mix(in srgb, {theme.color.primary.background} 12%, transparent)",
        "$description": "Wash behind a selected row or option. The accent at low opacity, so the row underneath still reads and several selected rows in a run do not become a solid block"
      },
      "success": {
        "background": {
          "$value": "{color.emerald.600}"
        },
        "backgroundHover": {
          "$value": "{color.emerald.700}"
        },
        "backgroundSubtle": {
          "$value": "{color.emerald.50}"
        },
        "text": {
          "$value": "{color.emerald.700}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.600}"
        },
        "backgroundHover": {
          "$value": "{color.amber.700}"
        },
        "backgroundSubtle": {
          "$value": "{color.amber.50}"
        },
        "text": {
          "$value": "{color.amber.700}"
        }
      },
      "error": {
        "background": {
          "$value": "{color.red.600}"
        },
        "backgroundHover": {
          "$value": "{color.red.700}"
        },
        "backgroundSubtle": {
          "$value": "{color.red.50}"
        },
        "text": {
          "$value": "{color.red.700}"
        }
      },
      "info": {
        "background": {
          "$value": "{color.blue.600}"
        },
        "backgroundHover": {
          "$value": "{color.blue.700}"
        },
        "backgroundSubtle": {
          "$value": "{color.blue.50}"
        },
        "text": {
          "$value": "{color.blue.700}"
        }
      },
      "background": {
        "default": {
          "$value": "{color.white}",
          "$description": "Page background"
        },
        "surface": {
          "$value": "{color.gray.50}",
          "$description": "Raised surface"
        },
        "muted": {
          "$value": "{color.gray.100}",
          "$description": "Muted fill, such as a hovered row"
        }
      },
      "text": {
        "default": {
          "$value": "{color.gray.950}",
          "$description": "Body text"
        },
        "muted": {
          "$value": "{color.gray.600}",
          "$description": "Secondary text; clears AA in both modes"
        },
        "inverse": {
          "$value": "{color.gray.50}",
          "$description": "Text on an inverted surface"
        }
      },
      "border": {
        "default": {
          "$value": "{color.gray.200}"
        },
        "muted": {
          "$value": "{color.gray.100}"
        },
        "strong": {
          "$value": "{color.gray.300}"
        }
      }
    }
  }
}
