{
  "theme": {
    "color": {
      "$type": "color",
      "primary": {
        "background": {
          "$value": "{color.teal.400}",
          "$description": "Teal background"
        },
        "backgroundHover": {
          "$value": "{color.teal.300}",
          "$description": "Background on hover"
        },
        "backgroundActive": {
          "$value": "{color.teal.200}",
          "$description": "Background when active"
        },
        "backgroundSubtle": {
          "$value": "{color.teal.950}",
          "$description": "Subtle background wash"
        },
        "text": {
          "$value": "{color.teal.300}",
          "$description": "Text colour on a plain background"
        },
        "textOnBackground": {
          "$value": "{color.gray.950}",
          "$description": "Text colour on the accent background"
        }
      },
      "secondary": {
        "background": {
          "$value": "{color.taupe.400}",
          "$description": "Taupe background"
        },
        "backgroundHover": {
          "$value": "{color.taupe.300}",
          "$description": "Background on hover"
        },
        "backgroundActive": {
          "$value": "{color.taupe.200}",
          "$description": "Background when active"
        },
        "backgroundSubtle": {
          "$value": "{color.taupe.950}",
          "$description": "Subtle background wash"
        },
        "text": {
          "$value": "{color.taupe.300}",
          "$description": "Text colour on a plain background"
        },
        "textOnBackground": {
          "$value": "{color.gray.950}",
          "$description": "Text colour on the accent background"
        }
      },
      "accent": {
        "$value": "{theme.color.primary.background}",
        "$description": "Colour of a control in its selected state \u2014 a ticked checkbox, a chosen radio, a range thumb. Follows the primary by default; retarget it here to move every such control at once"
      },
      "accentSubtle": {
        "$value": "color-mix(in srgb, {theme.color.primary.background} 22%, transparent)",
        "$description": "Wash behind a selected row or option. The accent at low opacity, so the row underneath still reads and several selected rows in a run do not become a solid block"
      },
      "focus": {
        "$value": "{color.blue.400}",
        "$description": "Focus ring. Deliberately not the accent: an accent says \"this is selected\" and a ring says \"the keyboard is here\", and a keyboard user needs to tell those apart on the same row. Blue also stays legible against the teal it will often sit next to"
      },
      "success": {
        "background": {
          "$value": "{color.emerald.400}"
        },
        "backgroundHover": {
          "$value": "{color.emerald.300}"
        },
        "backgroundSubtle": {
          "$value": "{color.emerald.950}"
        },
        "text": {
          "$value": "{color.emerald.300}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.400}"
        },
        "backgroundHover": {
          "$value": "{color.amber.300}"
        },
        "backgroundSubtle": {
          "$value": "{color.amber.950}"
        },
        "text": {
          "$value": "{color.amber.300}"
        }
      },
      "error": {
        "background": {
          "$value": "{color.red.400}"
        },
        "backgroundHover": {
          "$value": "{color.red.300}"
        },
        "backgroundSubtle": {
          "$value": "{color.red.950}"
        },
        "text": {
          "$value": "{color.red.300}"
        }
      },
      "info": {
        "background": {
          "$value": "{color.blue.400}"
        },
        "backgroundHover": {
          "$value": "{color.blue.300}"
        },
        "backgroundSubtle": {
          "$value": "{color.blue.950}"
        },
        "text": {
          "$value": "{color.blue.300}"
        }
      },
      "background": {
        "default": {
          "$value": "{color.gray.950}",
          "$description": "Page background"
        },
        "surface": {
          "$value": "{color.gray.900}",
          "$description": "Raised surface"
        },
        "muted": {
          "$value": "{color.gray.800}",
          "$description": "Muted fill, such as a hovered row"
        }
      },
      "text": {
        "default": {
          "$value": "{color.gray.50}",
          "$description": "Body text"
        },
        "muted": {
          "$value": "{color.gray.400}",
          "$description": "Secondary text; clears AA in both modes"
        },
        "inverse": {
          "$value": "{color.gray.950}",
          "$description": "Text on an inverted surface"
        }
      },
      "border": {
        "default": {
          "$value": "{color.gray.800}"
        },
        "muted": {
          "$value": "{color.gray.900}"
        },
        "strong": {
          "$value": "{color.gray.700}"
        }
      }
    }
  }
}
