{
  "font": {
    "family": {
      "sans": {
        "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "$description": "Base UI stack. System fonts, so no webfont has to load before the first paint"
      },
      "serif": {
        "$type": "string",
        "$value": "Georgia, 'Times New Roman', serif",
        "$description": "Serif font family"
      },
      "mono": {
        "$type": "string",
        "$value": "'Courier New', Courier, monospace",
        "$description": "Monospace font family"
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.6875rem"
      },
      "sm": {
        "$value": "0.75rem"
      },
      "base": {
        "$value": "0.8125rem"
      },
      "lg": {
        "$value": "0.875rem"
      },
      "xl": {
        "$value": "1rem"
      },
      "2xl": {
        "$value": "1.25rem"
      },
      "3xl": {
        "$value": "1.5rem"
      },
      "4xl": {
        "$value": "1.875rem"
      },
      "5xl": {
        "$value": "2.25rem"
      }
    },
    "weight": {
      "light": {
        "$type": "number",
        "$value": 300,
        "$description": "Light font weight"
      },
      "normal": {
        "$type": "number",
        "$value": 400,
        "$description": "Normal font weight"
      },
      "medium": {
        "$type": "number",
        "$value": 500,
        "$description": "Medium font weight"
      },
      "bold": {
        "$type": "number",
        "$value": 700,
        "$description": "Bold font weight"
      },
      "black": {
        "$type": "number",
        "$value": 900,
        "$description": "Black font weight"
      }
    },
    "numeric": {
      "$description": "Figure settings for tabular data",
      "variant": {
        "$value": "tabular-nums slashed-zero",
        "$description": "font-variant-numeric for columns of figures that must align"
      }
    }
  }
}
